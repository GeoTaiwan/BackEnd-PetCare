@model IEnumerable<TrainingCenterFinalProject.Models.SysMenu>

@{
    // ViewData["Title"] = "Index";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-outline-primary">建立新選單</a>
</p>
<table class="table table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MenuId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MenuName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ControllerName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ActionName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IconClass)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SortOrder)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RequiredAuthLevel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ParentId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsVisible)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.MenuId)
            </td>
            <td>
                @Html.DisplayFor(model => item.MenuName)
            </td>
            <td>
                @Html.DisplayFor(model => item.ControllerName)
            </td>
            <td>
                @Html.DisplayFor(model => item.ActionName)
            </td>
            <td>
                @Html.DisplayFor(model => item.IconClass)
            </td>
            <td>
                @Html.DisplayFor(model => item.SortOrder)
            </td>
            <td>
                @Html.DisplayFor(model => item.RequiredAuthLevel)
            </td>
            <td>
                @Html.DisplayFor(model => item.ParentId)
            </td>
            <td>
                @Html.DisplayFor(model => item.IsVisible)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MenuId" class="btn btn-outline-warning">編輯</a>
                @* <a asp-action="Delete" asp-route-id="@item.MenuId" class="btn btn-outline-danger">刪除</a> *@
                <form asp-action="Delete" asp-route-id="@item.MenuId" method="post" class="d-inline-block">
                    <button type="submit" class="btn btn-outline-danger" onclick="return confirm('確定要刪除這個選單嗎？');">刪除</button>
                </form>
            </td>
        </tr>
}
    </tbody>
</table>
