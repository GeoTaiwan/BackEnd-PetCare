@model IEnumerable<TrainingCenterFinalProject.Models.AuthorizationRecord>

@{
    // ViewData["Title"] = "Index";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
@if (Model.Any())
{
    
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Pet.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Institution.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GrantedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RevokedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Pet.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Institution.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.GrantedDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.RevokedDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.Status)
            </td>
           
            <td>
                <a asp-action="Edit" asp-route-id="@item.DataAuthorizationNumber">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.DataAuthorizationNumber">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.DataAuthorizationNumber">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
}
else
{
    <p>目前沒有授權紀錄。</p>
}

<a asp-action="Create" class="btn btn-primary">Create New Authorization Record</a>