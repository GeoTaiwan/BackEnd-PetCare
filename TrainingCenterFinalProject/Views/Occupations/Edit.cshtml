@model TrainingCenterFinalProject.Models.Occupations

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Occupations</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="OccupationID" />

            <div class="mb-3">
                <label asp-for="OccupationID" class="control-label"></label>
                <input asp-for="OccupationID" class="form-control" />
                <span asp-validation-for="OccupationID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="OccupationName" class="control-label"></label>
                <input asp-for="OccupationName" class="form-control" />
                <span asp-validation-for="OccupationName" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <input type="submit" value="確定存檔" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
