@model IEnumerable<TrainingCenterFinalProject.Models.TaskSchedule>

@{
    // ViewData["Title"] = "Index";
}

<h1>@(ViewBag.InstName)-@ViewData["Title"]</h1>

@* <p>
    <a asp-action="Create">建立任務</a>
</p> *@
@if (Model.Any())
{

    <table class="table table-hover">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Staff!.Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Institution!.Employments!.FirstOrDefault()!.OccupationDetails!.OccupationName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CreatedDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.StartTime)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.EndTime)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.TaskDescription)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Status)
                </th>

                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="align-middle">
                        @Html.DisplayFor(model => item.Staff!.Name)
                    </td>
                    <td class="align-middle">
                        @Html.DisplayFor(model => item.Institution!.Employments.FirstOrDefault()!.OccupationDetails!.OccupationName)
                    </td>
                    <td class="text-pre-line">@Html.DisplayFor(model => item.CreatedDate)</td>
                    <td class="text-pre-line">@Html.DisplayFor(model => item.StartTime)</td>
                    <td class="text-pre-line">@Html.DisplayFor(model => item.EndTime)</td>
                    <td class="align-middle">
                        @Html.DisplayFor(model => item.TaskDescription)
                    </td>
                    <td class="align-middle">
                        @Html.DisplayFor(model => item.Status)
                    </td>

                    <td class="align-middle">
                        <a asp-action="Edit" asp-route-taskid="@item.TaskID" class="btn btn-warning">編輯</a>
                        <form asp-action="Delete" asp-route-taskid="@item.TaskID" method="post" class="d-inline-block">
                            <button type="submit" class="btn btn-danger" onclick="return confirm('確定要刪除這個任務排程嗎？');">刪除</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info" role="alert">
        沒有任何任務排程資料。
    </div>
}
