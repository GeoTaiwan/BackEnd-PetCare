@model IEnumerable<TrainingCenterFinalProject.Models.TaskSchedule>

@{
    // ViewData["Title"] = "Index";
}

<h1>@(ViewBag.InstName)-@ViewData["Title"]</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Staff.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Institution!.Employments.FirstOrDefault().OccupationDetails.OccupationName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TaskDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
           
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Staff.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Institution!.Employments.FirstOrDefault().OccupationDetails.OccupationName)
            </td>
            <td class="text-pre-line">@Html.DisplayFor(model => item.CreatedDate)
            </td>
            <td class="text-pre-line">@Html.DisplayFor(model => item.StartTime)
            </td>
            <td class="text-pre-line">@Html.DisplayFor(model => item.EndTime)
            </td>
            <td>
                @Html.DisplayFor(model => item.TaskDescription)
            </td>
            <td>
                @Html.DisplayFor(model => item.Status)
            </td>
            
            <td>
                <a asp-action="Edit" asp-route-id="@item.TaskID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.TaskID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.TaskID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
