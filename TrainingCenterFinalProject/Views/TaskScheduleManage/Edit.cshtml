@model TrainingCenterFinalProject.Models.TaskSchedule

@{
    ViewData["Title"] = "編輯備註";
}

<h1>編輯備註</h1>

@* <h4>TaskSchedule</h4> *@
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="TaskID" />
			<input type="hidden" asp-for="AppointmentID" />
            <div class="mb-3">
                <label asp-for="StaffID" class="control-label"></label>
                <input type="hidden" asp-for="StaffID" class="form-control" />
                <input asp-for="Staff.Name" class="form-control" disabled readonly />
                <span asp-validation-for="StaffID" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="InstitutionID" class="control-label"></label>
                <input type="hidden" asp-for="InstitutionID" class="form-control" />
                <input asp-for="Institution.Name" class="form-control" disabled readonly />
                <span asp-validation-for="InstitutionID" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CreatedDate" class="control-label"></label>
                <input asp-for="CreatedDate" class="form-control" type="date" type="hidden" />
                <input asp-for="CreatedDate" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" disabled readonly />
                <span asp-validation-for="CreatedDate" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="StartTime" class="control-label"></label>
                <input asp-for="StartTime" class="form-control" type="datetime-local"type="hidden" />
                <input asp-for="StartTime" class="form-control" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" disabled readonly />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="EndTime" class="control-label"></label>
                <input asp-for="EndTime" class="form-control" type="datetime-local" type="hidden" />
                <input asp-for="EndTime" class="form-control" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" disabled readonly />
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TaskDescription" class="control-label"></label>
                <input asp-for="TaskDescription" class="form-control" />
                <span asp-validation-for="TaskDescription" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Status" class="control-label"></label>
                <input asp-for="Status" class="form-control" type="hidden" />
                <input asp-for="Status" class="form-control" disabled readonly />
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
