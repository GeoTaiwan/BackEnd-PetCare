@model TrainingCenterFinalProject.Models.AuthorizationRecord

@{
    // ViewData["Title"] = "Create";
}

<h1>@ViewData["Title"]</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="PetID" class="control-label">寵物呼名</label>
                <span class="form-control">@ViewBag.PetName</span>
                <input asp-for="PetID" class="form-control" type="hidden" />
                <span asp-validation-for="PetID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="InstitutionID" class="control-label">機構名稱</label>
                <span class="form-control">@ViewBag.InstName</span>
                <input asp-for="InstitutionID" class="form-control" type="hidden" />
                <span asp-validation-for="InstitutionID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GrantedDate" class="control-label"></label>
                <input asp-for="GrantedDate" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="GrantedDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RevokedDate" class="control-label"></label>
                <input asp-for="RevokedDate" class="form-control" type="date" />
                <span asp-validation-for="RevokedDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <input type="submit" value="確定申請" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" asp-controller="AuthorizationRecord" class="btn btn-info">返回授權管理</a>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}