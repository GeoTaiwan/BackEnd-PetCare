@{
    ViewData["Title"] = "首頁";
}

<div class="container mt-4">
    <!-- 歡迎區塊 (Hero Section) -->
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border-start border-5 border-info">
        <div class="container-fluid py-2">
            <img src="/images/PetCare.jpeg" class="img-fluid mb-3" alt="PetCare 寵物照護平台" />
            <h1 class="display-5 fw-bold text-dark mb-3">歡迎來到 PetCare 寵物照護平台</h1>
            <p class="col-md-8 fs-5 text-secondary">
                我們提供全方位的寵物生活管理，從日常健康紀錄、美容日誌到線上預約服務。
                無論您是疼愛毛孩的飼主，還是專業的寵物服務機構，都能在這裡找到最合適的工具。
            </p>
            @if (User.Identity?.IsAuthenticated == false)
            {
                <div class="mt-4">
                    <a href="/Account/Login" class="btn btn-primary btn-lg px-4 me-2">立即登入</a>
                    <a href="/Account/SendCode" class="btn btn-outline-secondary btn-lg px-4">註冊帳號</a>
                </div>
            }
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="row g-4 mb-5">
            <div class="col-12">
                <h3 class="mb-3 border-bottom pb-2 text-primary">我的毛孩專區</h3>
            </div>

            <!-- 卡片 1：寵物總覽 -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0 hover-card">
                    <div class="card-body text-center mt-3">
                        <i class="bi bi-heart-fill text-danger fs-1 mb-3"></i>
                        <h5 class="card-title fw-bold">我的寵物</h5>
                        <p class="card-text text-muted small">管理寵物基本資料、上傳可愛照片，以及追蹤體重變化。</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-4 text-center">
                        <a href="@Url.Action("Index", "Pet")" class="btn btn-outline-danger rounded-pill px-4">查看清單</a>
                    </div>
                </div>
            </div>

            <!-- 卡片 2：健康與美容紀錄 -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0 hover-card">
                    <div class="card-body text-center mt-3">
                        <i class="bi bi-journal-medical text-success fs-1 mb-3"></i>
                        <h5 class="card-title fw-bold">照護日誌</h5>
                        <p class="card-text text-muted small">快速查閱看診紀錄、檢驗報告，以及美容師的專屬照護筆記。</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-4 text-center">
                        <!-- 假設這裡導向寵物總覽，讓使用者點選單一寵物後查看紀錄 -->
                        <a href="@Url.Action("Index", "CareGroomingLog")" class="btn btn-outline-success rounded-pill px-4">檢視紀錄</a>
                    </div>
                </div>
            </div>

            <!-- 卡片 3：線上預約 -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0 hover-card">
                    <div class="card-body text-center mt-3">
                        <i class="bi bi-calendar-check text-warning fs-1 mb-3"></i>
                        <h5 class="card-title fw-bold">線上預約</h5>
                        <p class="card-text text-muted small">瀏覽合作機構，為您的毛孩預約看診或洗澡美容服務。</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-4 text-center">
                        <a href="@Url.Action("IndexForReservation", "Institution")" class="btn btn-outline-warning rounded-pill px-4 text-dark">立即預約</a>
                    </div>
                </div>
            </div>

            <!-- 卡片 4：預約查詢 -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0 hover-card">
                    <div class="card-body text-center mt-3">
                        <i class="bi bi-clock-history text-info fs-1 mb-3"></i>
                        <h5 class="card-title fw-bold">預約進度查詢</h5>
                        <p class="card-text text-muted small">追蹤您的預約單狀態，確認機構是否已接單並安排時段。</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-4 text-center">
                        <a href="@Url.Action("Index", "Appointment")" class="btn btn-outline-info rounded-pill px-4">查詢進度</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- 機構管理員專區 (可以透過 Role 或權限判斷，這裡先簡單展示) -->
        <div class="row g-4 mt-2">
            <div class="col-12">
                <h3 class="mb-3 border-bottom pb-2 text-secondary">合作機構專區</h3>
            </div>
            <div class="col-md-6">
                <div class="card bg-secondary text-white shadow-sm h-100">
                    <div class="card-body d-flex align-items-center">
                        <div class="me-4">
                            <i class="bi bi-shop fs-1"></i>
                        </div>
                        <div>
                            <h5 class="card-title fw-bold">管理我的機構</h5>
                            <p class="card-text mb-0">處理顧客預約、指派員工任務，並更新機構營業資訊。</p>
                        </div>
                    </div>
                    <a href="@Url.Action("Index", "Institution")" class="stretched-link"></a>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card bg-dark text-white shadow-sm h-100">
                    <div class="card-body d-flex align-items-center">
                        <div class="me-4">
                            <i class="bi bi-clipboard2-pulse fs-1"></i>
                        </div>
                        <div>
                            <h5 class="card-title fw-bold">建檔系統</h5>
                            <p class="card-text mb-0">為前來就診或美容的寵物建立詳細的醫療病歷與照護日誌。</p>
                        </div>
                    </div>
                    <!-- 假設導向機構管理頁面，裡面包含開立病歷的功能 -->
                    <a href="@Url.Action("Index", "Institution")" class="stretched-link"></a>
                </div>
            </div>
        </div>
    }
</div>

<!-- 加上一點點 CSS 讓卡片有浮動效果 -->
@section Scripts {
    <style>
        /* .hover-card {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }

            .hover-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
            } */
        /* 確保有引入 Bootstrap Icons */
        @@import url("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css");
    </style>
}