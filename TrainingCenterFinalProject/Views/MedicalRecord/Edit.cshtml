@model TrainingCenterFinalProject.Models.MedicalRecord

@{
	// ViewData["Title"] = "Edit";
	bool fromDetails = ViewBag.FromDetails ?? false;
}

<h1>@ViewData["Title"]</h1>
<h4>@Model.Pet.Name</h4>
<hr />
<div class="row">
	<div class="col-md-6">
		<form asp-action="Edit" enctype="multipart/form-data" asp-route-fromDetails="@fromDetails">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<input type="hidden" asp-for="RecordID" />
			<input type="hidden" asp-for="PetID" />
			<input type="hidden" asp-for="VetID" />
			<input type="hidden" asp-for="TestResultsFile" />
			<div class="mb-3">
				<label class="control-label">負責獸醫</label>
				<input asp-for="Vet.Name" class="form-control" disabled readonly />
				@* <span asp-validation-for="Vet.Name" class="text-danger"></span> *@
			</div>
			<div class="mb-3">
				<label asp-for="VisitDate" class="control-label"></label>
				<input asp-for="VisitDate" class="form-control" />
				<span asp-validation-for="VisitDate" class="text-danger"></span>
			</div>
			<div class="mb-3">
				<label asp-for="Symptoms" class="control-label"></label>
				<textarea asp-for="Symptoms" class="form-control"></textarea>
				<span asp-validation-for="Symptoms" class="text-danger"></span>
			</div>

			@if (Model.TestResultsFile != null)
			{
				<div class="mb-3">
					<label asp-for="TestResultsFile" class="control-label"></label>
					<br />
					<!-- 加上 type="file"，並命名為 uploadFile (這會對應 Controller 的參數) -->
					<!-- 可選: 使用 accept 限制上傳格式，例如 accept=".jpg,.png,.pdf" -->
					<a asp-controller="MedicalRecord"
					   asp-action="DownloadFile"
					   asp-route-fileName="@Model.TestResultsFile"
					   class="btn btn-sm btn-outline-primary">
						<i class="bi bi-download"></i> <span>@Model.TestResultsFile.Substring(37)</span>
					</a>
					@*建立刪除檔案的功能*@
					<button type="submit"
							asp-action="DeleteFile"
							asp-route-recordid="@Model.RecordID"
							class="btn btn-sm btn-danger d-inline-block"
							onclick="return confirm('確定要永久刪除這個檔案嗎？');">
						<i class="bi bi-trash"></i>
					</button>
					@*建立修改檔案的功能*@
					<button class="btn btn-sm btn-warning d-inline-block" data-bs-toggle="collapse" data-bs-target="#collapseFile" type="button">修改檔案</button>
					<div class="collapse" id="collapseFile">
						<input type="file" name="uploadFile" class="form-control" accept=".pdf,.doc,.docx,.txt,.jpg" />
						<input type="hidden" name="existingFileName" value="@(String.IsNullOrEmpty(Model.TestResultsFile) ? "" : Model.TestResultsFile)" />
					</div>
				</div>
			}
			else
			{
				<div class="mb-3">
					@*加上顯示檔案名稱*@
					<label asp-for="TestResultsFile" class="control-label"></label>
					<!-- 加上 type="file"，並命名為 uploadFile (這會對應 Controller 的參數) -->
					<!-- 可選: 使用 accept 限制上傳格式，例如 accept=".jpg,.png,.pdf" -->

					<input type="file" name="uploadFile" class="form-control" accept=".pdf,.doc,.docx,.txt,.jpg" />
					<span asp-validation-for="TestResultsFile" class="text-danger"></span>
				</div>
			}
			<div class="mb-3">
				<label asp-for="Diagnosis" class="control-label"></label>
				<textarea asp-for="Diagnosis" class="form-control"></textarea>
				<span asp-validation-for="Diagnosis" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<input type="submit" value="確定修改" class="btn btn-primary" />
			</div>
		</form>
	</div>

	@*右半*@
	<div class="col-md-6">
		<div class="container">
			@if (Model.TestResultsFile != null)
			{
				<div class="mb-3">
					<label class="control-label">檔案預覽</label>
					<br />
					<iframe src="@Url.Action("PreviewFile", "MedicalRecord", new { fileName = Model.TestResultsFile })" width="100%" height="500px"></iframe>
				</div>
			}
			else
			{
				<div class="mb-3">
					<label class="control-label">檔案預覽</label>
					<br />
					<p>尚無檔案可預覽</p>
				</div>
			}
			<img src="@(Model.Pet.ProfilePhotoUrl)" class="img-fluid" alt="Pet Profile Photo" />
		</div>
	</div>
</div>
	@if (fromDetails)
{
	<div>
		<a asp-action="Details" asp-route-id="@Model?.RecordID" class="btn btn-info">回到詳細資料</a>
	</div>

}
else
{
	<div class="mb-3">
		<a asp-action="Index" class="btn btn-secondary">返回列表</a>
	</div>
}

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
