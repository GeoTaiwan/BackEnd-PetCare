@model TrainingCenterFinalProject.Models.MedicalRecord

@{
	// ViewData["Title"] = "Details";
}

<h1>@ViewData["Title"]</h1>

<div>
	<hr />
	<dl class="row">
		<dt class="col-sm-2">
			@(Html.DisplayNameFor(model => model.Pet.Name))
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Pet.Name)
		</dd>
	</dl>
	<dl class="row">
		<dt class="col-sm-2">
			獸醫@(Html.DisplayNameFor(model => model.Vet.Name))
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Vet.Name)
		</dd>
	</dl>
	<dl class="row">
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.VisitDate)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.VisitDate)
		</dd>
	</dl>
	<dl class="row">
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Symptoms)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Symptoms)
		</dd>
	</dl>
	<dl class="row">
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.TestResultsFile)
		</dt>
		<dd class="col-sm-10">
			@if (!string.IsNullOrEmpty(Model.TestResultsFile))
			{
				<a asp-controller="MedicalRecord"
				   asp-action="DownloadFile"
				   asp-route-fileName="@Model.TestResultsFile"
				   class="btn btn-outline-primary"><i class="bi bi-download"></i> @Model.TestResultsFile.Substring(37)</a>
				@*建立刪除檔案的功能*@
				<form asp-action="DeleteFile" asp-route-recordid="@Model.RecordID" asp-route-fromdetails="true" method="post" class="d-inline-block">
					<button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('確定要永久刪除這個檔案嗎？');">
						<i class="bi bi-trash"></i> 刪除檔案
					</button>
				</form>
			}
			else
			{
				<span>無檢驗報告</span>
				//新增報告
				<button class="btn btn-warning" data-bs-toggle="collapse" data-bs-target="#collapseFile" type="button">上傳檔案</button>
				<form asp-action="UploadFile" asp-route-recordid="@Model.RecordID" asp-route-fromdetails="true" enctype="multipart/form-data" class="collapse" id="collapseFile">
						<input type="file" name="uploadFile" class="form-control" accept=".pdf,.doc,.docx,.txt,.jpg" />
						<input type="hidden" name="existingFileName" value="@(String.IsNullOrEmpty(Model.TestResultsFile) ? "" : Model.TestResultsFile)" />
						<input type="submit" class="btn btn-primary" value="確定上傳" />
				</form>
				
			}
			
		</dd>
	</dl>
	<dl class="row">
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Diagnosis)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Diagnosis)
		</dd>
	</dl>
</div>
<div>
	<a asp-action="Edit" asp-route-recordid="@Model?.RecordID" asp-route-fromDetails="true" class="btn btn-warning">編輯</a>
	<a asp-action="Index" class="btn btn-info">回到列表</a>
</div>
