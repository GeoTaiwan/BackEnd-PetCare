@model TrainingCenterFinalProject.Models.MedicalRecord

@{
    // ViewData["Title"] = "Create";
}

<h1>@ViewData["Title"]</h1>

@* <h4>MedicalRecord</h4>
<hr /> *@
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" asp-route-fromdetails="@ViewBag.FromDetails" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
			
            <div class="mb-3">
                <label asp-for="PetID" class="control-label"></label>
                <input asp-for="PetID" class="form-control" type="hidden" />
				<input value="@ViewBag.PetName" class="form-control" disabled />
                <span asp-validation-for="PetID" class="text-danger"></span>
            </div>

            @* <div class="mb-3">
                <label asp-for="VetID" class="control-label"></label>
                <input asp-for="VetID" class="form-control" />
                <span asp-validation-for="VetID" class="text-danger"></span>
            </div> *@

            <div class="mb-3">
                <label asp-for="VisitDate" class="control-label"></label>
                <input asp-for="VisitDate" class="form-control" />
                <span asp-validation-for="VisitDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Symptoms" class="control-label"></label>
                <input asp-for="Symptoms" class="form-control" />
                <span asp-validation-for="Symptoms" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TestResultsFile" class="control-label"></label>
                <!-- 加上 type="file"，並命名為 uploadFile (這會對應 Controller 的參數) -->
                <!-- 可選: 使用 accept 限制上傳格式，例如 accept=".jpg,.png,.pdf" -->
                <input type="file" name="uploadFile" class="form-control" accept=".pdf,.doc,.docx,.txt,.jpg" />
                <span asp-validation-for="TestResultsFile" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Diagnosis" class="control-label"></label>
                <textarea asp-for="Diagnosis" class="form-control"></textarea>
                @* <input asp-for="Diagnosis" class="form-control" /> *@
                <span asp-validation-for="Diagnosis" class="text-danger"></span>
            </div>

           
            <div class="">
                <input type="submit" value="確定建立" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<div>
@if (ViewBag.FromDetails)
{
    
        <a asp-action="Details" asp-controller="Pet" asp-route-petid="@ViewBag.PetID" class="btn btn-info">回寵物資料</a>
    
}else
{
    
        <a asp-action="Index" asp-route-petid="@ViewBag.PetID" asp-route-institutionID="@ViewBag.InstitutionID" class="btn btn-info">回病歷管理</a>
    
}
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

