@model IEnumerable<TrainingCenterFinalProject.Models.MedicalRecord>

@{
	// ViewData["Title"] = "Details";
	bool isVet = User.IsInRole("Vet") || User.IsInRole("VetManage");
	bool isBeauty = User.IsInRole("Beauty") || User.IsInRole("BeautyManage");
	bool isNanny = User.IsInRole("Nanny") || User.IsInRole("NannyManage");
	string occupationTitle = "";
	if (isVet)
	{
		occupationTitle = "獸醫";
	}
	else if (isBeauty)
	{
		occupationTitle = "美容師";
	}
	else if (isNanny)
	{
		occupationTitle = "保母";
	}
}

<h1>@(ViewBag.InstitutionName)-@ViewData["Title"]</h1>
@* <h3>病歷列表</h3> *@



@if (Model != null && Model.Any())
{
	<table class="table table-hover">
		<thead>
			<tr>
				<th>負責@(occupationTitle)@Html.DisplayNameFor(model => model.Vet.Name)</th>
				<th>@Html.DisplayNameFor(model => model.Pet.Name)</th>
				<th>@Html.DisplayNameFor(model => model.VisitDate)</th>
				<th>@Html.DisplayNameFor(model => model.Symptoms)</th>
				<th>@Html.DisplayNameFor(model => model.TestResultsFile)</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>@Html.DisplayFor(model => item.Vet.Name)</td>
                    <td>@Html.DisplayFor(model => item.Pet.Name)</td>
					<td>@Html.DisplayFor(model => item.VisitDate)</td>
					<td>@Html.DisplayFor(model => item.Symptoms)</td>
					<td>@Html.DisplayFor(model => item.TestResultsFile)</td>
					<td>
						@*修正，僅可編輯當日病歷，避免修改過去病歷*@ 
						@{
							bool isEditable = item.VisitDate.Date == DateTime.Now.Date;
						}
						@if (isEditable)
						{
							<a asp-action="Edit" asp-route-recordid="@item.RecordID" asp-route-fromDetails="false" class="btn btn-warning">編輯</a>
						}
						<a asp-action="Create" asp-route-petid="@item.PetID" class="btn btn-primary">新增病歷</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<p>目前沒有已授權病歷紀錄。</p>
}
@if (ViewBag.FromIndex != null && (bool)ViewBag.FromIndex)
{
	<a asp-controller="PetManage" asp-action="Index" class="btn btn-info">回寵物管理</a>
}
else
{
	@* <a asp-action="Index" class="btn btn-info">回病歷管理</a>			 *@
}