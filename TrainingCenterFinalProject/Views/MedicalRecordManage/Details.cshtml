@model IEnumerable<TrainingCenterFinalProject.Models.MedicalRecord>

@{
	// ViewData["Title"] = "Details";
}

<h1>@ViewData["Title"]</h1>


@if (Model != null && Model.Any())
{
	<table class="table table-hover">
		<thead>
			<tr>
				<th>Record ID</th>
				<th>Pet Name</th>
				<th>Vet Name</th>
				<th>Date</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>@item.RecordID</td>
					<td>@item.Pet.Name</td>
					<td>@item.Vet.Name</td>
					<td>@item.VisitDate</td>
					<td>
						<a asp-action="Edit" asp-route-recordid="@item.RecordID" asp-route-fromDetails="true" class="btn btn-warning">編輯</a>
						<a asp-action="Index" class="btn btn-info">回到列表</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<p>目前沒有病歷紀錄。</p>
}