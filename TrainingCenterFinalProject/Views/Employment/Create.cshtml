@* @model TrainingCenterFinalProject.Models.Employment *@
@model PetCare.ViewModels.NewEmployeeViewModel

@{
    // ViewData["Title"] = "新增員工";
}
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" name="fromInstManage" value="@ViewBag.fromInstManage.ToString().ToLower()" />
            <div class="mb-3">
                <label asp-for="InstitutionName" class="control-label"></label>
                <input asp-for="InstitutionID" class="form-control" type="hidden" />
                <input asp-for="InstitutionName" class="form-control" readonly disabled />
                <span asp-validation-for="InstitutionName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserEmail" class="control-label"></label>
                <input asp-for="UserEmail" class="form-control" />
                <span asp-validation-for="UserEmail" class="text-danger"></span>
            </div>

            

            <div class="mb-3">
                <label asp-for="OccupationID" class="control-label"></label>
                <select asp-for="OccupationID" asp-items="ViewBag.OccupationList" class="form-control"></select>
                <span asp-validation-for="OccupationID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="control-label"></label>
                @* <input asp-for="Status" class="form-control" /> *@
                <select asp-for="Status" asp-items="ViewBag.StatusList" class="form-control"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LicenseNumber" class="control-label"></label>
                <input asp-for="LicenseNumber" class="form-control" />
                <span asp-validation-for="LicenseNumber" class="text-danger"></span>
            </div>

          @*   <div class="mb-3">
                <label asp-for="StartDate" class="control-label"></label>
                <input asp-for="StartDate" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EndDate" class="control-label"></label>
                <input asp-for="EndDate" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div> *@

            <div class="mb-3">
                <input type="submit" value="確定新增" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
@if (ViewBag.fromInstManage)
{
    <div>
        <a asp-controller="Institution" asp-action="InstitutionManage" asp-route-id="@Model.InstitutionID">回機構管理</a>
    </div>
}
else
{
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
}

@section Scripts{
@{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}