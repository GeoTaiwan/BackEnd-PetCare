@model IEnumerable<TrainingCenterFinalProject.Models.Employment>

@{
    // ViewData["Title"] = "Index";
}

<h1>@ViewBag.InstitutionName-@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">新增員工</a>
</p>
<table class="table table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Institution.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OccupationDetails.OccupationName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LicenseNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndDate)
            </th>
            
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Institution.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.OccupationDetails.OccupationName)
            </td>
            <td>
                @Html.DisplayFor(model => item.Status)
            </td>
            <td>
                @Html.DisplayFor(model => item.LicenseNumber)
            </td>
            <td>
                @Html.DisplayFor(model => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.EndDate)
            </td>
            
            <td>
                <a asp-action="Edit" asp-route-id="@item.UserID" class="btn btn-warning">編輯</a>
                <a asp-action="Delete" asp-route-id="@item.UserID" class="btn btn-danger">刪除</a>
            </td>
        </tr>
}
    </tbody>
</table>
