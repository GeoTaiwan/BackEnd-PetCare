@model IEnumerable<TrainingCenterFinalProject.Models.Employment>

@{
    // ViewData["Title"] = "Index";
    bool isManager = User.IsInRole("VetManage") || User.IsInRole("NannyManage")||User.IsInRole("BeautyManage");
    // var statusList = new[]
    //     {
    //         new { Value = "Active", Text = "在職 (Active)" },
    //         new { Value = "Inactive", Text = "離職 (Inactive)" },
    //         new { Value = "Suspended", Text = "停職 (Suspended)" } 可隨時擴充
    //     };
    Dictionary<string, string> statusDictionary = new Dictionary<string, string>
    {
        { "Active", "在職 (Active)" },
        { "Inactive", "離職 (Inactive)" },
        { "Suspended", "停職 (Suspended)" }
    };
}

<h1>@ViewBag.InstitutionName-@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" asp-route-instid="@(Model.FirstOrDefault()?.InstitutionID)" class="btn btn-primary">新增員工</a>
</p>
<table class="table table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UserProfile.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OccupationDetails.OccupationName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LicenseNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndDate)
            </th>
            
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.UserProfile.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.OccupationDetails.OccupationName)
            </td>
            <td>
                @statusDictionary[item.Status]
            </td>
            <td>
                @Html.DisplayFor(model => item.LicenseNumber)
            </td>
            <td>
                @Html.DisplayFor(model => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.EndDate)
            </td>
            
            <td>
                @if (isManager)
                {
                <a asp-action="Edit" asp-route-id="@item.UserID" class="btn btn-warning">編輯</a>
                
                }
            </td>
        </tr>
}
    </tbody>
</table>
