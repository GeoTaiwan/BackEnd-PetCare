@model IEnumerable<TrainingCenterFinalProject.Models.CareGroomingLog>

@{
    // ViewData["Title"] = "Index";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create">新增資料</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Pet.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Staff.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LogDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ActivityDetails)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DietNotes)
            </th>
            
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Pet.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Staff.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.LogDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.ActivityDetails)
            </td>
            <td>
                @Html.DisplayFor(model => item.DietNotes)
            </td>
            
            <td>
                <a asp-action="Edit" asp-route-logid="@item.LogID" class="btn btn-warning">編輯</a>
                <a asp-action="Details" asp-route-logid="@item.LogID" class="btn btn-info">詳細資料</a>
                <a asp-action="Delete" asp-route-logid="@item.LogID" class="btn btn-danger">刪除</a>
            </td>
        </tr>
}
    </tbody>
</table>
