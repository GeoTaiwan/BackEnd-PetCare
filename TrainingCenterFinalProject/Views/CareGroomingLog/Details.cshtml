@model TrainingCenterFinalProject.Models.CareGroomingLog

@{
    
}

<h1>@(Model.Pet.Name)@(ViewData["Title"])</h1>

<div>
    
    <hr />
    <dl class="row">
        <!-- 顯示紀錄時間 -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.LogDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LogDate)
        </dd>

        <!-- 顯示關聯的寵物名稱 -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Pet.Name)
        </dt>
        <dd class="col-sm-10">
            @if (Model.Pet != null)
            {
                <text>@Model.Pet.Name (@Model.Pet.Species)</text>
            }
            else
            {
                <span class="text-muted">無寵物資料</span>
            }
        </dd>

        <!-- 顯示負責美容師/保姆名稱 -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.StaffID)
        </dt>
        <dd class="col-sm-10">
            @if (Model.Staff != null)
            {
                @Model.Staff.Name
            }
            else
            {
                <span class="text-muted">無員工資料</span>
            }
        </dd>

        <!-- 顯示照護或美容過程描述 -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ActivityDetails)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ActivityDetails)
        </dd>

        <!-- 顯示飲食與排泄狀況紀錄 -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DietNotes)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DietNotes)
        </dd>
    </dl>
</div>

<!-- 實況照片區塊 -->
<div class="mt-4">
    <h5>實況照片</h5>
    <hr />
    <div id="logPhotos">
    
    </div>
</div>

<div id="uploadPhotos">

</div>

<div class="mt-4">
    <a asp-action="Edit" asp-route-logid="@Model?.LogID" asp-route-fromDetails="true" class="btn btn-warning">編輯</a>
    <a asp-action="Index" class="btn btn-info">返回列表</a>
</div>

@section Scripts {
    <script>
        // 這裡可以加入一些 JavaScript 來處理照片的動態載入或其他互動功能
        $('#uploadPhotos').load("@Url.Action("UploadPhoto", "LogPhoto", new { logid = Model.LogID })");
        $('#logPhotos').load("@Url.Action("Index", "LogPhoto", new { logid = Model.LogID })");  
        // 刪除照片的 JavaScript 函數
        function deletePhoto(event, photoId, logId) {
            event.preventDefault(); // 防止表單提交
            if (confirm("確定要刪除這張照片嗎？")) {
                $.ajax({
                    url: '@Url.Action("DeletePhoto", "LogPhoto")',
                    type: 'POST',
                    data: { photoId: photoId, logId: logId },
                    success: function(result) {
                        // 刪除成功後重新載入照片列表
                        $('#logPhotos').load("@Url.Action("Index", "LogPhoto", new { logid = Model.LogID })");
                    },
                    error: function(xhr, status, error) {
                        alert("刪除照片時發生錯誤：" + error);
                    }
                });
            }
        }
    </script>
}