@model TrainingCenterFinalProject.Models.CareGroomingLog

@{
    
}

<h1>@(Model.Pet.Name)@(ViewData["Title"])</h1>

<div>
    
    <hr />
    <dl class="row">
        <!-- 顯示紀錄時間 -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.LogDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LogDate)
        </dd>

        <!-- 顯示關聯的寵物名稱 -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PetID)
        </dt>
        <dd class="col-sm-10">
            @if (Model.Pet != null)
            {
                <text>@Model.Pet.Name (@Model.Pet.Species)</text>
            }
            else
            {
                <span class="text-muted">無寵物資料</span>
            }
        </dd>

        <!-- 顯示負責美容師/保姆名稱 -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.StaffID)
        </dt>
        <dd class="col-sm-10">
            @if (Model.Staff != null)
            {
                @Model.Staff.Name
            }
            else
            {
                <span class="text-muted">無員工資料</span>
            }
        </dd>

        <!-- 顯示照護或美容過程描述 -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ActivityDetails)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ActivityDetails)
        </dd>

        <!-- 顯示飲食與排泄狀況紀錄 -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DietNotes)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DietNotes)
        </dd>
    </dl>
</div>

<!-- 實況照片區塊 -->
<div class="mt-4">
    <h5>實況照片</h5>
    <hr />
    @if (Model.LogPhotos != null && Model.LogPhotos.Any())
    {
        <div class="row">
            @foreach (var photo in Model.LogPhotos)
            {
                <div class="col-md-3 mb-3">
                    <div class="card">
                        <!-- 假設 ImageURL 儲存的是相對路徑或絕對網址 -->
                        <img src="~/uploads/logPhotos/@photo.ImageURL" class="card-img-top img-thumbnail" alt="實況照片" style="object-fit: cover; height: 200px;" />
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">目前沒有上傳任何實況照片。</p>
    }
</div>

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model?.LogID" class="btn btn-warning">編輯</a>
    <a asp-action="Index" class="btn btn-info">返回列表</a>
</div>


