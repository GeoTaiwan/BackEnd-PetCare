@model IEnumerable<TrainingCenterFinalProject.Models.Appointment>

@{
    // ViewData["Title"] = "Index";
}

<h1>@ViewData["Title"]</h1>
@*實作下拉式選單，篩選寵物顯示預約，預設為飼主有的所有寵物*@ 
<select id="petSelect" class="form-select mb-3" onchange="filterAppointments()" asp-items="ViewBag.PetList">
    <option value="">所有寵物</option>
</select>
@* <p>
    <a asp-action="Create">新增預約</a>
</p> *@

@if (Model.Any())
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Pet.Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Institution.Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ServiceType)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ApptDateTime)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Status)
                </th>

                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(model => item.Pet.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Institution.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.ServiceType)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.ApptDateTime)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Status)
                    </td>

                    <td>

                        @*把delete改為表單*@
                        @if (item.Status == "已申請待確認")
                        {
                            <a asp-action="Edit" asp-route-id="@item.AppointmentID" class="btn btn-warning">編輯</a>
                        <form asp-action="Delete" asp-route-id="@item.AppointmentID" method="post" class="d-inline-block" onsubmit="return confirm('確定要刪除這筆預約嗎？');">
                            <button type="submit" class="btn btn-danger">刪除</button>
                        </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>目前沒有預約紀錄。</p>
}

@section Scripts {
	<script>
		function filterAppointments() {
			var selectedPetId = document.getElementById("petSelect").value;
			var url = '@Url.Action("Index", "Appointment")';
			if (selectedPetId) {
				url += '?petid=' + selectedPetId;
			}
			window.location.href = url;
		}
	</script>
}