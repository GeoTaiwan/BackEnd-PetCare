@model IEnumerable<TrainingCenterFinalProject.Models.Pet>

@{
    // ViewData["Title"] = "Index";
}

<h1>@(ViewBag.institutionName)-@ViewData["Title"]</h1>

@* <p class="text-end">
    <a asp-action="Create" class="btn btn-primary">加入寵物</a>
</p> *@
@if (Model.Any())
{
    <div class="row row-cols-1 row-cols-md-4 g-4">
        @foreach (var item in Model)
        {

            bool isValid = item.AuthorizationRecords.Any(ar => ar.Status == "Authorized" && ar.GrantedDate <= DateTime.Now && ar.RevokedDate >= DateTime.Now);
            bool isVet = ViewBag.isVet ?? false;
            <div class="col">
                <div class="card h-100 shadow-sm border-0 hover-card">

                    @if (!string.IsNullOrEmpty(item.ProfilePhotoUrl))
                    {
                        <img src="@item.ProfilePhotoUrl?v=@DateTime.Now.Ticks" alt="寵物照片" class="card-img-top" style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <img src="/images/cat.jpg" alt="無照片" class="card-img-top" style="height: 200px; object-fit: cover;" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text">@Html.Raw((item.SpecialNotes ?? "").Replace("\r\n", "<br>"))</p>
                        <a asp-action="Details" asp-route-petid="@item.PetID" class="stretched-link"></a>
                    </div>

                    <div class="card-footer">
                        @if (isValid)
                        {
                            if (isVet)
                            {
                                <a asp-controller="MedicalRecordManage" asp-action="Index" asp-route-petid="@item.PetID" asp-route-fromIndex="true" class="btn btn-success position-relative z-2">
                                    病歷列表
                                </a>
                            }
                            else
                            {
                                //新增照護紀錄按鈕

                            }
                        }
                        else
                        {
                            //檢查是否接受預約
                            var hasPendingAppointment = item.Appointments.Any(a => a.Status == "預約成功");
                            if (hasPendingAppointment)
                            {
                                //檢查是否已申請授權
                                var hasPending = item.AuthorizationRecords.Any(ar => ar.Status == "Pending");
                                var hasAuthorized = item.AuthorizationRecords.Any(ar => ar.Status == "Authorized");
                                if (!hasPending && !hasAuthorized)
                                {
                                    //要求授權按鈕get
                                    <a asp-action="Create" asp-controller="AuthorizationRecordManage" asp-route-petid="@item.PetID" class="btn btn-warning position-relative z-2">要求授權</a>
                                }
                                else
                                {
                                    <span class="text-warning">已申請授權</span>
                                }
                            }
                            else if (item.Appointments.Any(a => a.Status == "預約失敗"))
                            {
                                //目前沒有接受預約
                            }
                            else
                            {
                                //顯示是否接受預約
                                <span>是否接受預約</span>
                                <form asp-controller="AppointmentManage" asp-action="Accept" method="post" style="display:inline">
                                    <input type="hidden" name="appointmentid" value="@item.Appointments.FirstOrDefault()?.AppointmentID" />
                                    <button type="submit" class="btn btn-success position-relative z-2" onclick="return confirm('確定要接受這個預約嗎？');">接受</button>
                                </form>
                                <form asp-controller="AppointmentManage" asp-action="Reject" method="post" style="display:inline">
                                    <input type="hidden" name="appointmentid" value="@item.Appointments.FirstOrDefault()?.AppointmentID" />
                                    <button type="submit" class="btn btn-danger position-relative z-2" onclick="return confirm('確定要拒絕這個預約嗎？');">拒絕</button>
                                </form>
                            }

                        }
                    </div>

                </div>
            </div>
        }

    </div>
}
else
{
    <h1 class="text-center">目前尚無寵物預約</h1>
}



