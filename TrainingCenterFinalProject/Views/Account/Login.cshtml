@model TrainingCenterFinalProject.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "會員登入";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h3 class="card-title text-center mb-4">會員登入</h3>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success text-center">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    @if (ViewData["Alert"] != null)
                    {
                        <h6 class="text-danger text-center">@ViewData["Alert"]</h6>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <h6 class="text-danger text-center">@TempData["ErrorMessage"]</h6>
                    }

                    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Account" class="form-label"></label>
                            <input asp-for="Account" class="form-control" placeholder="請輸入 Email 或 使用者代號" />
                            <span asp-validation-for="Account" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" placeholder="請輸入密碼" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label"></label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">登入</button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-4 text-center">
    <p>或使用其他帳號登入：</p>

    <!-- Google 登入按鈕 -->
    <a asp-action="ExternalLogin"
       asp-route-provider="Google"
       asp-route-returnUrl="@ViewData["ReturnUrl"]"
       class="btn btn-outline-danger me-2">
        <i class="bi bi-google"></i> Google 登入
    </a>

    <!-- LINE 登入按鈕 -->
    <a asp-action="ExternalLogin"
       asp-route-provider="Line"
       asp-route-returnUrl="@ViewData["ReturnUrl"]"
       class="btn btn-outline-success">
        <i class="bi bi-chat-fill"></i> LINE 登入
    </a>
</div>

@section Scripts {
    <!-- 載入前端驗證腳本 (jQuery Validation) -->
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @{
        // 先將 TempData 轉型為字串存入區域變數
        var registerSuccessMsg = TempData["RegisterSuccess"] as string;
		var email = TempData["Email"] as string;
    }

    <!-- 檢查區域變數是否有值 -->
    @if (!string.IsNullOrEmpty(registerSuccessMsg))
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                Swal.fire({
                    title: '成功！',
                    // 直接輸出剛剛存起來的區域變數
                    text: '@Html.Raw(registerSuccessMsg)',
                    icon: 'success',
                    confirmButtonText: '確定',
                    confirmButtonColor: '#198754'
                });
                
                // 如果有 email，將其填入帳號欄位
                var email = '@Html.Raw(email)';
                if (email) {
                    document.querySelector('input[name="Account"]').value = email;
                }
            });
        </script>
    }
}