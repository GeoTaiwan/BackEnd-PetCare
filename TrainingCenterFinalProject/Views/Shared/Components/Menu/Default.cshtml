@model IEnumerable<TrainingCenterFinalProject.Models.SysMenu>

@* <div class="list-group"> *@
    @foreach (var menu in Model)
    {
        // 判斷目前所在的 Controller 和 Action，如果是的話就加上 active CSS class 來 Highlight
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var isActive = (menu.ControllerName == currentController && menu.ActionName == currentAction) ? "active" : "";
        <li class="nav-item">
            <a href="/@menu.ControllerName/@menu.ActionName" class="nav-link text-dark @isActive">
                <!-- 如果有設定 Icon 的話可以在這裡顯示 -->
                @if (!string.IsNullOrEmpty(menu.IconClass))
                {
                    <i class="@menu.IconClass"></i>
                }
                @menu.MenuName
            </a>
        </li>
    }
@* </div> *@