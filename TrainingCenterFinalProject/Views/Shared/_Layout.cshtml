
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PetCare</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PetCare.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/PetCare.jpeg" alt="PetCare" />
                    </a>
                }
                else
                {
                    <a class="navbar-brand" asp-area="" asp-controller="Account" asp-action="Login">
                        <img src="~/images/PetCare.jpeg" alt="PetCare" />
                    </a>
                }

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @*若登入者為admin則不顯示*@
                        @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Member"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                                </li>
                            }
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @* <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="UserProfile" asp-action="Index">使用者列表</a>
                            </li> *@
                            @await Component.InvokeAsync("Menu")

                            @* <li class="nav-item">
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    <!-- 這是防護 CSRF 攻擊的關鍵，ASP.NET Core 通常會自動加，但顯式寫出來是好習慣 -->
                                    @Html.AntiForgeryToken()

                                    <!-- 把 <a> 換成 <button>，並用 CSS 把它偽裝成文字連結 -->
                                    <button type="submit" class="nav-link btn btn-link text-dark" style="border: none; background: none; outline: none;">
                                        登出
                                    </button>
                                </form>
                            </li> *@
                        }

                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            
                            <span class="text-dark text-nowrap">歡迎, @User.Identity.Name!</span>

                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                
                                <button type="submit" class="btn btn-info btn-sm text-nowrap">
                                    登出
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="nav-link text-dark text-nowrap" asp-controller="Account" asp-action="Login">登入</a>
                            <a class="btn btn-outline-primary btn-sm text-nowrap" asp-controller="Account" asp-action="SendCode">註冊</a>
                        }
                    </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-mute">
        <div class="container">
            &copy; 2026 - TrainingCenterFinalProject - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
