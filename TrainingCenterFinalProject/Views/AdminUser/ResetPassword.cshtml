@model TrainingCenterFinalProject.ViewModels.AdminResetPasswordViewModel

@{
    ViewData["Title"] = "重設使用者密碼";
}

<h2>重設密碼</h2>
<hr />

<div class="row">
    <div class="col-md-4">
        <!-- 顯示要修改誰的密碼，避免改錯人 -->
        <div class="alert alert-info">
            正在修改 <strong>@Model.UserName</strong> (@Model.UserID) 的密碼
        </div>

        <form asp-action="ResetPassword">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- 隱藏 UserID 與 UserName 欄位，一起 Post 回後端 -->
            <input type="hidden" asp-for="UserID" />
            <input type="hidden" asp-for="UserName" />

            <div class="form-group mb-3">
                <label asp-for="NewPassword" class="control-label"></label>
                <input asp-for="NewPassword" class="form-control" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ConfirmPassword" class="control-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <input type="submit" value="確認重設" class="btn btn-danger" />
                <a asp-action="Index" asp-controller="UserProfile" class="btn btn-secondary">返回列表</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}