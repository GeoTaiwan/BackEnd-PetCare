@model IEnumerable<TrainingCenterFinalProject.Models.Appointment>

@{
	// ViewData["Title"] = "Index";
}

<h1>@ViewBag.InstName-@ViewData["Title"]</h1>

@if (Model.Any())
{
	<!-- 1. 新增 Bootstrap Toggle (Switch) 開關 -->
	<div class="form-check form-switch mb-3">
		<input class="form-check-input" type="checkbox" role="switch" id="toggleHandled" checked>
		<label class="form-check-label" for="toggleHandled">顯示已處理的預約</label>
	</div>

	<table class="table table-hover">
		<thead>
			<tr>
				<th>@Html.DisplayNameFor(model => model.Pet.Name)</th>
				<th>@Html.DisplayNameFor(model => model.ServiceType)</th>
				<th>@Html.DisplayNameFor(model => model.ApptDateTime)</th>
				<th>@Html.DisplayNameFor(model => model.ApplyTime)</th>
				<th>@Html.DisplayNameFor(model => model.HandleTime)</th>
				<th>處理人員</th>
				<th>預約@(Html.DisplayNameFor(model => model.Status))</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				// 2. 判斷該筆預約是否已處理，並賦予對應的 class
				bool isHandled = (item.Status == "預約成功" || item.Status == "預約失敗");
				string rowClass = isHandled ? "handled-row" : "pending-row";

				<tr class="position-relative @rowClass">
					<td class="align-middle">@Html.DisplayFor(model => item.Pet.Name)</td>
					<td class="align-middle">@Html.DisplayFor(model => item.ServiceType)</td>
					<td class="text-pre-line">@Html.DisplayFor(model => item.ApptDateTime)</td>
					<td class="text-pre-line">@Html.DisplayFor(model => item.ApplyTime)</td>
					<td class="text-pre-line">@Html.DisplayFor(model => item.HandleTime)</td>
					<td class="align-middle">@Html.DisplayFor(model => item.Employee.Name)</td>
					<td class="align-middle">
						@if (item.Status == "預約成功")
						{
							<span class="text-success">已接受</span>
						}
						else if (item.Status == "預約失敗")
						{
							<span class="text-danger">已拒絕</span>
						}
						else
						{
							<span class="text-warning">
								@Html.DisplayFor(model => item.Status)
							</span>
						}
					</td>

					<td class="align-middle">
						<a class="stretched-link" asp-action="Details" asp-route-appointmentid="@item.AppointmentID"></a>

						@if (!isHandled && item.ApptDateTime>= DateTime.Now)
						{
							<form asp-action="Accept" method="post" style="display:inline">
								<input type="hidden" name="appointmentid" value="@item.AppointmentID" />
								<button type="submit" class="btn btn-success position-relative z-2" onclick="return confirm('確定要接受這個預約嗎？');">接受</button>
							</form>
							<form asp-action="Reject" method="post" style="display:inline">
								<input type="hidden" name="appointmentid" value="@item.AppointmentID" />
								<button type="submit" class="btn btn-danger position-relative z-2" onclick="return confirm('確定要拒絕這個預約嗎？');">拒絕</button>
							</form>
						} else if (item.ApptDateTime < DateTime.Now)
						{
							<span class="text-danger">已過期</span>
						}
						else if (item.Status == "預約成功")
						{
							if (item.Institution.AuthorizationRecords
							.Where(ar => ar.PetID == item.PetID && ar.Status == "Pending").Any())
							{
								<span class="text-warning">已申請授權</span>
							}
							else if (item.Institution.AuthorizationRecords
							.Where(ar => ar.PetID == item.PetID && ar.Status == "Authorized" && ar.RevokedDate >= DateTime.Now).Any())
							{
								<span class="text-success">已授權</span>
								@* <a asp-controller="MedicalRecordManage" asp-action="Index" asp-route-petid="@item.PetID" asp-route-institutionid="@item.InstitutionID" class="btn btn-info position-relative z-2">
									查看病歷
									</a> *@
							}
							else
							{
								<a asp-controller="AuthorizationRecordManage" asp-action="Create" asp-route-petid="@item.PetID" asp-route-institutionid="@item.InstitutionID" class="btn btn-info position-relative z-2">
									要求授權
								</a>
								
							}
							bool hasAssigned = item.TaskSchedule?.Status == "Active";
							if (hasAssigned)
							{
								<span class="text-success">已指派【@(item.TaskSchedule?.Staff?.Name)】</span>
							}
							else
							{
								<form asp-controller="TaskScheduleManage" asp-action="AssignEmployee" method="post" class="d-inline-block position-relative z-2">
									<h4 class="text-danger">@TempData[$"ErrMsg_{item.AppointmentID}"]</h4>
									<select name="StaffID" class="form-select" asp-items="ViewBag.EmployeeList"></select>
									<input type="hidden" name="AppointmentID" value="@item.AppointmentID" />
									<input type="hidden" name="InstitutionID" value="@item.InstitutionID" />
									<input type="hidden" name="StartTime" value="@item.ApptDateTime" />
									<input name="TaskDescription" value="" placeholder="備註" />
									<button type="submit" class="btn btn-primary position-relative z-2" onclick="return confirm('確定要指派【' + document.querySelector('select[name=\'StaffID\']').selectedOptions[0].text + '】嗎？');">指派員工</button>
								</form>
							}
						}
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<p>目前沒有任何預約。</p>
}

<!-- 3. 加入 JavaScript 控制邏輯 -->
@section Scripts {
	<script>
		document.addEventListener("DOMContentLoaded", function() {
			const toggleSwitch = document.getElementById('toggleHandled');
			const handledRows = document.querySelectorAll('.handled-row');

			// 定義切換顯示狀態的函數
			function updateVisibility() {
				const showHandled = toggleSwitch.checked;
				handledRows.forEach(row => {
					// 如果勾選，顯示列 (清除 inline style)；如果取消勾選，隱藏列 (display: none)
					row.style.display = showHandled ? '' : 'none';
				});
			}

			// 網頁載入時先執行一次 (依照預設的 checked 狀態)
			updateVisibility();

			// 當開關被點擊時，觸發切換
			toggleSwitch.addEventListener('change', updateVisibility);
		});
	</script>
}