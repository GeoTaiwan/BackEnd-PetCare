@{
    Layout = null;
}
<form asp-action="UploadPhoto" asp-controller="LogPhoto" method="post" enctype="multipart/form-data" id="uploadPhotoForm">
    <input type="hidden" name="logid" value="@ViewData["LogID"]" class="form-control" />
    <input type="file" name="uploadedFiles" multiple class="form-control" />
    <button class="form-control btn btn-primary" onclick="uploadPhoto(event)">確定上傳</button>
</form>