@model IEnumerable<TrainingCenterFinalProject.Models.LogPhoto>

@{
    // ViewData["Title"] = "Index";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.LogID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImageURL)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.LogID)
            </td>
            <td>
                @Html.DisplayFor(model => item.ImageURL)
            </td>
            <td>
                @Html.DisplayFor(model => item.CreatedDate)
            </td>
            <td>
                <a asp-action="Edit" asp-route-photoid="@item.PhotoID">Edit</a> |
                <a asp-action="Details" asp-route-photoid="@item.PhotoID">Details</a> |
                <a asp-action="Delete" asp-route-photoid="@item.PhotoID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
