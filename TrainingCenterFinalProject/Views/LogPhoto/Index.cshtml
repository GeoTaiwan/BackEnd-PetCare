@model IEnumerable<TrainingCenterFinalProject.Models.LogPhoto>

@{
    // ViewData["Title"] = "Index";
    Layout = null;
    //修改index頁，提供給CareGroomingLog的Details頁面使用，顯示該紀錄的所有照片
}

@if (Model != null && Model.Any())
{
    <div class="row" id="logPhotos">
        @foreach (var photo in Model)
        {
            <div class="col-md-3 mb-3">
                <div class="card">
                    <!-- 假設 ImageURL 儲存的是相對路徑或絕對網址 -->
                    <img src="@photo.ImageURL" class="card-img-top img-thumbnail" alt="實況照片" style="object-fit: cover; height: 200px;" />
                    <div class="card-body">
                        <p class="card-text text-center">@photo.CreatedDate</p>
                    </div>
                    <div class="footer">
                        @*刪除鈕使用自訂submit，呼叫在Scripts區塊中的刪除
                                使用者在刪除照片時不會跳轉頁面，並且可以即時更新照片列表
                            *@
                        <a class="btn btn-danger btn-sm" onclick="deletePhoto(event, @photo.PhotoID, @photo.LogID)">刪除</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted">目前沒有上傳任何實況照片。</p>
}
